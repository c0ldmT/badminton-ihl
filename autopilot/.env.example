# ---- LLM-Endpunkt (OpenAI-kompatibel) für Planner-Briefing und Reviews ----
# Standard: Ollama. Performance-Profil llama.cpp: http://localhost:8080/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.6:35b
# LLM_API_KEY=local            # lokal nicht nötig

# ---- Coder über OpenCode (muss zum selben Modell zeigen -> kein Modellwechsel) ----
OPENCODE_BIN=opencode
OPENCODE_MODEL=ollama/qwen3.6:35b
# llama.cpp-Profil:  LLM_MODEL=qwen3.6-35b-a3b  und  OPENCODE_MODEL=llamacpp/qwen3.6-35b-a3b
# Leicht-Profil:     LLM_MODEL=qwen3.5:9b       und  OPENCODE_MODEL=ollama/qwen3.5:9b

# ---- Loop-Steuerung ----
MAX_REVISIONS=3            # Fehlversuche pro Task, danach "blocked" + Rollback
MAX_BLOCKED_IN_ROW=2       # so viele blockierte Tasks hintereinander -> Lauf stoppt
CODER_TIMEOUT_MIN=45       # Zeitlimit pro Coder-Versuch
CHECK_TIMEOUT_MIN=20       # Zeitlimit für scripts/check.sh
CHECK_BUILD=1              # 0 = ohne `next build` prüfen (schneller, weniger streng)
REVIEW_DIFF_CHARS=48000    # Diff-Budget für Reviewer (~12-16k Tokens)
RESET_DB_ON_ROLLBACK=1     # Dev-DB nach Rollback einer Schema-Task zurücksetzen
LLM_TIMEOUT_S=1800
